meta {
  name: "1. Choice (Intent Classification)"
  type: http
  seq: 1
}

post {
  url: https://api.typesafe.ai/v1/systemone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{JEV_API_KEY}}
}

body:json {
  {
    "model": "jev-latest",
    "state": "내일 오전 10시에 회의실 A 예약해줄래?",
    "questions": {
      "intent": {
        "type": "choice",
        "instructions": "사용자의 의도를 분류하세요.",
        "criteria": {
          "meeting": "회의 예약 및 일정 관리",
          "email": "이메일 작성 및 확인",
          "chat": "단순 일상 대화"
        }
      }
    }
  }
}
